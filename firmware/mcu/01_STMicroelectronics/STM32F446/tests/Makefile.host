CC ?= cc
CFLAGS ?= -std=c99 -Wall -Wextra -Werror -pedantic -O0 -g

MODEL := ..
PORT := $(MODEL)/ads1299_port
EXAMPLES := $(MODEL)/examples
CORE := ../../../core_driver/ads1299
PACKET := ../../../common/data_packet

INCLUDES := -I$(PORT) -I$(EXAMPLES) -I$(CORE) -I$(PACKET)

TEST_SRCS := \
	test_main.c \
	test_frame.c \
	test_register.c \
	test_spi.c \
	test_reset.c \
	test_drdy.c \
	test_packet.c \
	test_frame_queue.c

PORT_SRCS := \
	$(PORT)/ads1299_spi.c \
	$(PORT)/ads1299_gpio.c \
	$(PORT)/ads1299_drdy.c

EXAMPLE_SRCS := \
	$(EXAMPLES)/stm32f446_frame_queue.c

CORE_SRCS := \
	$(CORE)/ads1299.c \
	$(CORE)/ads1299_frame.c \
	$(CORE)/ads1299_model.c \
	$(CORE)/ads1299_multi.c

PACKET_SRCS := \
	$(PACKET)/ads1299_packet.c

TARGET := stm32f446_ads1299_host_tests

.PHONY: all test clean
all: $(TARGET)

$(TARGET): $(TEST_SRCS) $(PORT_SRCS) $(EXAMPLE_SRCS) $(CORE_SRCS) $(PACKET_SRCS)
	$(CC) $(CFLAGS) $(INCLUDES) $^ -o $@

test: $(TARGET)
	./$(TARGET)

clean:
	rm -f $(TARGET)
